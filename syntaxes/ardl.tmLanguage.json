{
  "name": "ardl",
  "scopeName": "source.ardl",
  "fileTypes": [
    ".ardl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.ardl",
      "match": "\\b(ecuAbstraction|sensorActuator|complexDriver|application|composition|transformer|component|exclusive|interface|parameter|prototype|semaphore|implicit|protocol|receives|resource|runnable|services|switched|switches|connect|profile|service|startup|written|enters|layers|prport|queued|result|writes|calls|count|depth|ecual|error|event|every|gives|inout|layer|locks|modes|mutex|param|pport|queue|reads|rport|sends|takes|title|waits|call|core|data|init|mcal|mode|prio|runs|sent|sets|task|uses|view|bsw|cat|cdd|e2e|isr|out|swc|cs|in|nv|of|on|os|sr)\\b"
    },
    {
      "name": "string.quoted.double.ardl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.ardl",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ardl"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ardl"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.ardl"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.ardl"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.ardl",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
